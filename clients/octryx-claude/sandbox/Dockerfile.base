# syntax=docker/dockerfile:1
# octryx-sandbox-base: the octryx-claude device runner, headless, for one platform run.
# Build: docker build -f Dockerfile.base --build-arg OCTRYX_BASE_URL=https://<platform> -t sandbox-base .
# Runs with a read-only root as uid 10001; /workspace and /tmp are emptyDir volumes.
FROM node:22.12.0-bookworm-slim@sha256:35531c52ce27b6575d69755c73e65d4468dba93a25644eed56dc12879cae9213 AS node

FROM python:3.12.8-slim-bookworm@sha256:2199a62885a12290dc9c5be3ca0681d367576ab7bf037da120e564723292a2f0
ARG OCTRYX_BASE_URL
ARG CLAUDE_CODE_VERSION=2.1.318

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git tini \
 && rm -rf /var/lib/apt/lists/*

# Node (for the Claude Code CLI and node toolchains) from the official image, no apt repository needed.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack

# octryx-claude: the platform's wheel at build time (sha256 checked), never installed at runtime.
COPY fetch-wheel.sh entry.sh /opt/octryx-sandbox/
RUN python -m venv /opt/octryx \
 && /opt/octryx-sandbox/fetch-wheel.sh "$OCTRYX_BASE_URL" /tmp/wheel \
 && /opt/octryx/bin/pip install --no-cache-dir /tmp/wheel/*.whl \
 && rm -rf /tmp/wheel

RUN npm install -g --no-fund --no-audit "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
 && npm cache clean --force

RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin octryx

ENV PATH=/opt/octryx/bin:$PATH \
    HOME=/tmp/home \
    OCTRYX_CLAUDE_HOME=/tmp/octryx \
    OCTRYX_WORKSPACE=/workspace \
    OCTRYX_CLAUDE_AUTO_UPDATE=0 \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    npm_config_cache=/tmp/home/.npm \
    PIP_CACHE_DIR=/tmp/home/.cache/pip

WORKDIR /workspace
USER 10001
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/octryx-sandbox/entry.sh"]
