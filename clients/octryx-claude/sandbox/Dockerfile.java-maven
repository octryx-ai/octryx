# syntax=docker/dockerfile:1
# octryx-sandbox-java-maven: sandbox-base + Temurin 21 + Maven 3.9.
ARG BASE_IMAGE=octryx-sandbox-base
FROM eclipse-temurin:21.0.5_11-jdk@sha256:d59ca4960a17035592a5c928343ba56862ea6067929da4e776d7a0f4ec26aa44 AS jdk

FROM ${BASE_IMAGE}
ARG MAVEN_VERSION=3.9.9
USER root
COPY --from=jdk /opt/java/openjdk /opt/java/openjdk
RUN curl -fsSL "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" -o /tmp/maven.tgz \
 && curl -fsSL "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz.sha512" -o /tmp/maven.sha512 \
 && echo "$(cat /tmp/maven.sha512)  /tmp/maven.tgz" | sha512sum -c - \
 && mkdir -p /opt/maven && tar -xzf /tmp/maven.tgz -C /opt/maven --strip-components=1 \
 && rm -f /tmp/maven.tgz /tmp/maven.sha512
# MAVEN_MIRROR (a later Nexus/Artifactory) becomes ~/.m2/settings.xml at start (octryx_claude.sandbox).
ENV JAVA_HOME=/opt/java/openjdk \
    PATH=/opt/java/openjdk/bin:/opt/maven/bin:$PATH \
    MAVEN_OPTS="-Dmaven.repo.local=/tmp/home/.m2/repository"
USER 10001
