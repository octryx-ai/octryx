# The runners' only way to the platform: the api's port, nothing else on its network. The Host is the platform's
# own, so the knowledge MCP's host check passes.
map $http_upgrade $connection_upgrade {
  default upgrade;
  "" close;
}
server {
  listen 8000;
  client_max_body_size 64m;
  location / {
    proxy_pass http://pod:8000;
    proxy_http_version 1.1;
    proxy_set_header Host ${OCTRYX_PUBLIC_HOST};
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_buffering off;
  }
}
