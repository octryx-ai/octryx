 "rules": [
  {
   "id": "R1",
   "title": "Härte-Umrechnung",
   "identifier": "hardnessToPpm",
   "numeric": true,
   "text": "1 °fH = 10 ppm; 1 °dH = 17.848 ppm; Anzeige mit 1 Dezimale.",
   "examples": [
    {
     "given": "Zürcher Leitungswasser 15 °fH",
     "expect": "150.0 ppm, 8.4 °dH",
     "realistic": true
    },
    {
     "given": "8.4 °dH",
     "expect": "149.9 ppm"
    }
   ]
  },
  {
   "id": "R3",
   "title": "Ruhezeit",
   "identifier": "readyDate",
   "numeric": true,
   "text": "readyDate = roastDate + restDays(Methode, Röstgrad); zu alt ab roastDate + 45 Tage.",
   "params": [
    {
     "id": "espressoMedium",
     "label": "Espresso medium",
     "value": "10",
     "unit": "Tage"
    },
    {
     "id": "filterMedium",
     "label": "Filter medium",
     "value": "5",
     "unit": "Tage"
    }
   ],
   "examples": [
    {
     "given": "Brazil Cerrado, Röstung 01.11.2026, medium",
     "expect": "Filter bereit 06.11., Espresso bereit 11.11., zu alt ab 16.12.2026",
     "realistic": true
    }
   ]
  },
  {
   "id": "R5",
   "title": "Bestellhinweis",
   "identifier": "orderPoint",
   "numeric": true,
   "text": "orderPoint = Verbrauch/Tag × (Lieferzeit + Ruhetage) + Mindestbestand; Hinweis, wenn Bestand ≤ orderPoint.",
   "params": [
    {
     "id": "leadTimeDays",
     "label": "Lieferzeit",
     "value": "3",
     "unit": "Tage"
    },
    {
     "id": "minStockDays",
     "label": "Mindestbestand",
     "value": "2",
     "unit": "Tage Verbrauch"
    }
   ],
   "examples": [
    {
     "given": "18 g/Tag (2 Shots), Lieferzeit 3, Espresso medium 10 Tage, Bestand 250 g",
     "expect": "Bestellpunkt 270 g → „Jetzt bestellen“",
     "realistic": true
    },
    {
     "given": "Ohne Verbrauch",
     "expect": "Bestellpunkt 100 g"
    }
   ]
  },
  {
   "id": "R6",
   "title": "Lückenwarnung",
   "identifier": "gapWarning",
   "numeric": true,
   "text": "Lücke von runOutDate + 1 bis nextReady − 1, wenn trinkbereiter Bestand vorher ausgeht.",
   "examples": [
    {
     "given": "Heute 16.11.2026, 90 g trinkbereit, 18 g/Tag, ruhende Packung bereit 25.11.",
     "expect": "Lücke 21.11.–24.11.2026, Aktion „Packung X öffnen“",
     "realistic": true
    }
   ]
  },
  {
   "id": "R9",
   "title": "Espresso-Empfehlung",
   "identifier": "espressoAdvice",
   "numeric": true,
   "text": "Genau eine Variable: Wasser vor Ruhezeit vor Mahlgrad; Zeit 25–30 s hat Vorrang vor dem Geschmack; 1 Rasterstufe, 2 bei < 20 s oder > 35 s.",
   "params": [
    {
     "id": "steps",
     "label": "Stufen pro Änderung",
     "value": "1",
     "unit": "Stufe"
    }
   ],
   "examples": [
    {
     "given": "DF83V (0–90, Schritt 1, feiner = abwärts), Stufe 22, sauer, 27 s",
     "expect": "Stufe 21 („1 Stufe feiner“)",
     "realistic": true
    },
    {
     "given": "Bitter, 17 s, Stufe 22",
     "expect": "Stufe 20 (Zeit gewinnt, 2 Stufen feiner)"
    }
   ]
  },
  {
   "id": "R10",
   "title": "Filter-Rezept",
   "identifier": "filterRecipe",
   "numeric": true,
   "text": "W = Dosis × Verhältnis; Bloom 2 × Dosis; Zwischensummen 0.375 W, 0.6875 W, W.",
   "params": [
    {
     "id": "ratio",
     "label": "Verhältnis 1 :",
     "value": "16",
     "unit": ""
    }
   ],
   "examples": [
    {
     "given": "V60, 20 g, 1:16",
     "expect": "320 g Wasser, Bloom 40 g, 120 / 220 / 320 g",
     "realistic": true
    }
   ]
  }
 ],
