# Octryx native development (./dev-setup.sh, ./dev-start.sh): copy to .env.
# For installing and testing with Docker, use .env.example and https://octryx.ai/docs/install/docker instead.

# ── App ──
# Local alpha defaults only. Production-like runtime profiles must override
# placeholder secrets, use PostgreSQL, disable wildcard CORS, and force secure
# auth cookies.
APP_NAME=Octryx
DEBUG=true
OCTRYX_RUNTIME_PROFILE=local
HOST=0.0.0.0
PORT=8000

# ── Database ──
# SQLite (local development/test fixture only)
DATABASE_URL=sqlite+aiosqlite:///./data/octryx.db
# PostgreSQL (required for production-like runtime profiles)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/octryx

# ── JWT Auth ──
# Replace for every production-like runtime profile.
JWT_SECRET=change-me-to-a-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Encryption (for user tokens) ──
# Replace for every production-like runtime profile.
ENCRYPTION_KEY=change-me-to-32-char-encryption-key

# ── LLM Providers ──
# Provider: openrouter, bedrock, copilot (leave empty for no default provider)
LLM_PROVIDER=
OPENROUTER_API_KEY=
AWS_REGION=eu-central-1
AWS_BEDROCK_ROLE_ARN=
# GitHub OAuth App client ID for Copilot device login.
# Create an Octryx-owned OAuth app with device flow enabled; do not use a third-party client id.
COPILOT_OAUTH_CLIENT_ID=

# ── Auth cookies and proxy boundary ──
# FORCE_SECURE_AUTH_COOKIES=true is authoritative: auth cookies then always carry
# Secure, whatever scheme the app itself observes. Required for every
# production-like runtime profile, including TLS-terminating ingress setups.
# false is only allowed together with DEBUG=true and a local runtime profile, and
# then only applies to unproxied loopback HTTP requests.
FORCE_SECURE_AUTH_COOKIES=false
AUTH_COOKIE_SAMESITE=lax
# Reverse proxies whose forwarded request metadata may be trusted (IPs or CIDRs,
# comma-separated). Empty means deny-by-default: no forwarded header is read, and
# scheme, client address, rate-limit bucketing, and audit attribution all use the
# transport peer. Set this to the ingress/proxy addresses behind a reverse proxy;
# trust-all values (*, 0.0.0.0/0, ::/0) are rejected at startup, as is any set of
# entries that together covers all of IPv4 or IPv6.
TRUSTED_PROXY_IPS=

# ── Multipart upload admission ──
# Hard ceiling in bytes on a whole multipart request, applied before any form
# parsing and before authentication (FastAPI parses the body before it solves a
# route's dependencies). Counted on raw request bytes, so a missing or dishonest
# Content-Length and chunked delivery are bounded too; framing that is ambiguous
# (duplicate or malformed Content-Length) is refused with a fixed 400 instead.
# Unset means the default: 512 MiB plus a 64 KiB envelope allowance, which is the
# largest payload a current upload route accepts (office template / corporate
# identity packages). Lower it to the largest upload the deployment really needs;
# routes with their own lower ceiling (Workspace Knowledge Evidence, 8 MiB) stay
# lower either way. Invalid values and values above 1 GiB fail startup — there is
# no "unlimited" setting, and nothing is silently clamped. Reverse-proxy and
# ingress body limits remain separate and do not replace this one.
# MAX_MULTIPART_REQUEST_BYTES=8454144

# ── Bootstrap ──
# Local dev seed credentials only. Never use for production-like startup.
ADMIN_DEFAULT_PASSWORD=admin
ADMIN_EMAIL=admin@localhost

# ── Agent ──
AGENT_DEFAULT_MODEL=anthropic/claude-3.5-sonnet
AGENT_MAX_TOOL_CALLS_PER_SESSION=50
