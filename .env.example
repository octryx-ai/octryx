# Octryx AI, local install: copy to .env and fill in ONE model access below.
# Everything else (database, object store, secrets) is set up by `docker compose up`.

# ── Model access: pick exactly one block ──

# LLM_PROVIDER takes one of: anthropic, openai, bedrock, openrouter. Any other value creates no model access (the
# start log says so); every other model (Azure OpenAI, Google Gemini, Ollama, ...) is added in Admin › Models after
# the first sign-in.

# A) Anthropic API key (https://console.anthropic.com).
LLM_PROVIDER=anthropic
AGENT_DEFAULT_MODEL=claude-sonnet-5-5
LLM_API_KEY=

# B) Any OpenAI-compatible endpoint (OpenAI, Azure OpenAI, vLLM, LM Studio, Ollama, ...).
# LLM_PROVIDER=openai
# AGENT_DEFAULT_MODEL=gpt-4.1
# LLM_ENDPOINT_URL=https://api.openai.com/v1
# LLM_API_KEY=

# C) AWS Bedrock. Credentials of a user or role allowed to call bedrock:InvokeModel, in a region where the model is
#    enabled. With AWS SSO: aws configure export-credentials --profile <name> --format env-no-export >> .env
#    SSO credentials expire after hours; the model then stops working until you enter new ones in Admin › Models
#    (this file is read only at the first start). A long-lived key pair does not expire.
# LLM_PROVIDER=bedrock
# AGENT_DEFAULT_MODEL=<a model id enabled in your region, e.g. eu.anthropic.claude-sonnet-5-5>
# AWS_REGION=<your region>
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ── Optional ──

# Port on localhost (default 8000).
# OCTRYX_PORT=8000

# Extra services, comma-separated: ollama, workers, code-intelligence.
# COMPOSE_PROFILES=ollama

# The local demo (deployment/demo/README.md; not for production): the demo file on top of the main one.
# COMPOSE_FILE=docker-compose.yml:docker-compose.demo.yml
# OCTRYX_DEMO_GIT_PORT=8434

# Use an image you built and pushed to your own registry instead of the local build (then: docker compose pull).
# OCTRYX_IMAGE=<registry>/<image>:<tag>
