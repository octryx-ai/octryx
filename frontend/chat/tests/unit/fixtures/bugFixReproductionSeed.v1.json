{
 "key": "bug-fix-reproduction",
 "definition": {
  "execution_kind": "phased",
  "plan_node": "reproduce",
  "failure_policy": {
   "comment_per_round": true,
   "follow_up_on_loop_limit": true,
   "follow_up_issue_type": "Task"
  },
  "nodes": [
   {
    "id": "start",
    "type": "start",
    "label": "Start"
   },
   {
    "id": "ticket",
    "type": "platform_action",
    "label": "Bug ticket",
    "config": {
     "action": "jira.create_issue",
     "params": {
      "issue_type": "Bug",
      "summary_from": "work_item",
      "description_from": "work_item"
     }
    }
   },
   {
    "id": "branch",
    "type": "platform_action",
    "label": "Bugfix branch",
    "config": {
     "action": "scm.create_branch",
     "params": {
      "branch_type": "bugfix"
     }
    }
   },
   {
    "id": "prepare",
    "type": "platform_action",
    "label": "Prepare the working folder",
    "config": {
     "action": "workspace.prepare"
    }
   },
   {
    "id": "reproduce",
    "type": "phase",
    "label": "Reproduce",
    "config": {
     "agent": "engineer",
     "workflow_id": "coding_change_tdd",
     "workflow_class": "coding_change_tdd",
     "workflow_contract": {
      "workflow_id": "coding_change_tdd",
      "workflow_class": "coding_change_tdd",
      "capability_class": "change",
      "routing_intent": "coding",
      "required_model_capability": "coding",
      "when_to_use": "Read the reported bug (the Work item, its ticket, or the incident hypothesis the run received) and write an automated test that reproduces it; run it with the rest of the suite \u2014 it must fail on an assertion that shows the reported symptom, while every other test keeps passing. Then submit_reproduction with the failing test ids and the symptom. Do not fix the bug in this phase.",
      "checks": [
       {
        "type": "tool_called",
        "params": {
         "tools": [
          "run_test_suite"
         ]
        },
        "blocking": true,
        "description": "The test suite ran"
       },
       {
        "type": "tool_called",
        "params": {
         "tools": [
          "submit_reproduction"
         ]
        },
        "blocking": true,
        "description": "The reproduction was submitted"
       },
       {
        "type": "lint_passed",
        "params": {},
        "blocking": true,
        "description": "The declared lint command passes for the run change"
       }
      ],
      "path_rules": {
       "write": [
        "tests/**",
        "test/**",
        "**/tests/**",
        "**/test/**",
        "**/test_*",
        "**/*_test.*",
        "**/*Test.*",
        "**/*.test.*",
        "**/*_spec.*"
       ]
      }
     },
     "tool_policy": {
      "allowlist": [
       "analyze_workspace_repository",
       "code_search",
       "grep_workspace",
       "glob_workspace_files",
       "list_workspace_directory",
       "read_workspace_file",
       "get_git_diff",
       "write_workspace_file",
       "edit_workspace_file",
       "multi_edit_workspace_file",
       "run_test_suite",
       "knowledge_search",
       "spawn_sub_agent",
       "get_context_from_subthreads",
       "todo_read",
       "todo_write",
       "work_item_context",
       "get_jira_ticket",
       "submit_reproduction"
      ],
      "denylist": []
     },
     "output": "reproduction"
    }
   },
   {
    "id": "confirm_repro",
    "type": "user_confirmation",
    "label": "Confirm the reproduction",
    "config": {
     "subject": "reproduction"
    }
   },
   {
    "id": "reproduces",
    "type": "gate",
    "label": "Reproduces",
    "config": {
     "checks": [
      {
       "type": "reproduces",
       "params": {
        "regression": "suite"
       },
       "blocking": true,
       "description": "The confirmed test fails with the confirmed symptom; no other test fails"
      }
     ]
    }
   },
   {
    "id": "fix",
    "type": "phase",
    "label": "Minimal fix",
    "config": {
     "agent": "engineer",
     "workflow_id": "coding_change_tdd",
     "workflow_class": "coding_change_tdd",
     "workflow_contract": {
      "workflow_id": "coding_change_tdd",
      "workflow_class": "coding_change_tdd",
      "capability_class": "change",
      "routing_intent": "coding",
      "required_model_capability": "coding",
      "when_to_use": "Make the smallest change that makes the confirmed reproduction test pass without breaking any other test; run the full test suite.",
      "checks": [
       {
        "type": "tool_called",
        "params": {
         "tools": [
          "run_test_suite"
         ]
        },
        "blocking": true,
        "description": "The test suite ran"
       },
       {
        "type": "test_command_passed",
        "params": {},
        "blocking": true,
        "description": "The last test run after the last change passed"
       },
       {
        "type": "lint_passed",
        "params": {},
        "blocking": true,
        "description": "The declared lint command passes for the run change"
       }
      ],
      "path_rules": {
       "protect_confirmed_tests": true
      }
     },
     "tool_policy": {
      "allowlist": [
       "analyze_workspace_repository",
       "code_search",
       "grep_workspace",
       "glob_workspace_files",
       "list_workspace_directory",
       "read_workspace_file",
       "get_git_diff",
       "write_workspace_file",
       "edit_workspace_file",
       "multi_edit_workspace_file",
       "run_test_suite",
       "knowledge_search",
       "spawn_sub_agent",
       "get_context_from_subthreads",
       "todo_read",
       "todo_write"
      ],
      "denylist": []
     },
     "inputs": [
      "reproduction"
     ]
    }
   },
   {
    "id": "green",
    "type": "gate",
    "label": "Green",
    "config": {
     "checks": [
      {
       "type": "tests_green",
       "params": {},
       "blocking": true,
       "description": "The confirmed tests passed after failing, the suite is green"
      },
      {
       "type": "confirmed_tests_intact",
       "params": {},
       "blocking": true,
       "description": "The confirmed tests are still there and not skipped"
      },
      {
       "type": "lint_passed",
       "params": {},
       "blocking": true,
       "description": "The declared lint command passes before review and push"
      }
     ]
    }
   },
   {
    "id": "independent_review",
    "type": "review",
    "label": "Independent review",
    "config": {
     "phase": "fix"
    }
   },
   {
    "id": "review",
    "type": "gate",
    "label": "Review and evidence",
    "config": {
     "phase": "fix",
     "checks": [
      {
       "type": "review_passed",
       "params": {},
       "blocking": true,
       "description": "The independent reviewer passed the change"
      },
      {
       "type": "test_command_passed",
       "params": {},
       "blocking": true,
       "description": "The last test run after the last change passed"
      },
      {
       "type": "confirmed_tests_intact",
       "params": {},
       "blocking": true,
       "description": "The confirmed tests are still there and not skipped"
      }
     ]
    }
   },
   {
    "id": "push",
    "type": "platform_action",
    "label": "Push",
    "config": {
     "action": "scm.push"
    }
   },
   {
    "id": "pr",
    "type": "platform_action",
    "label": "Pull request",
    "config": {
     "action": "scm.open_pr"
    }
   },
   {
    "id": "in_review",
    "type": "platform_action",
    "label": "Work item in review",
    "config": {
     "action": "jira.transition",
     "params": {
      "work_state": "review"
     }
    }
   },
   {
    "id": "ci",
    "type": "watch",
    "label": "CI on the pushed commit",
    "config": {
     "conditions": [
      "ci.succeeded",
      "ci.failed"
     ],
     "advance": "auto"
    }
   },
   {
    "id": "merged",
    "type": "watch",
    "label": "Merged",
    "config": {
     "conditions": [
      "pr.merged",
      "pr.declined"
     ],
     "advance": "confirm"
    }
   },
   {
    "id": "retry",
    "type": "user_confirmation",
    "label": "Declined: how to go on",
    "config": {
     "subject": "retry_choice"
    }
   },
   {
    "id": "action_failed",
    "type": "pause",
    "label": "A step failed: retry, change or abort",
    "config": {
     "reason": "action_failed"
    }
   },
   {
    "id": "done",
    "type": "outcome",
    "label": "Done",
    "config": {
     "outcome": "done",
     "work_state": "done"
    }
   },
   {
    "id": "blocked",
    "type": "outcome",
    "label": "Blocked",
    "config": {
     "outcome": "blocked"
    }
   },
   {
    "id": "stopped",
    "type": "outcome",
    "label": "Stopped",
    "config": {
     "outcome": "stopped"
    }
   }
  ],
  "edges": [
   {
    "id": "e-start",
    "source_node_id": "start",
    "target_node_id": "ticket"
   },
   {
    "id": "e-ticket",
    "source_node_id": "ticket",
    "target_node_id": "branch",
    "when": "succeeded"
   },
   {
    "id": "e-ticket-ko",
    "source_node_id": "ticket",
    "target_node_id": "action_failed",
    "when": "failed"
   },
   {
    "id": "e-branch",
    "source_node_id": "branch",
    "target_node_id": "prepare",
    "when": "succeeded"
   },
   {
    "id": "e-prepare",
    "source_node_id": "prepare",
    "target_node_id": "reproduce",
    "when": "succeeded"
   },
   {
    "id": "e-prepare-ko",
    "source_node_id": "prepare",
    "target_node_id": "action_failed",
    "when": "failed"
   },
   {
    "id": "e-branch-ko",
    "source_node_id": "branch",
    "target_node_id": "action_failed",
    "when": "failed"
   },
   {
    "id": "e-repro",
    "source_node_id": "reproduce",
    "target_node_id": "confirm_repro"
   },
   {
    "id": "e-confirmed",
    "source_node_id": "confirm_repro",
    "target_node_id": "reproduces",
    "when": "confirmed"
   },
   {
    "id": "loop-repro-change",
    "source_node_id": "confirm_repro",
    "target_node_id": "reproduce",
    "when": "changed",
    "kind": "loop",
    "max_iterations": 2,
    "label": "Reproduction \u2194 your review"
   },
   {
    "id": "e-repro-stop",
    "source_node_id": "confirm_repro",
    "target_node_id": "stopped",
    "when": "stopped"
   },
   {
    "id": "e-reproduces",
    "source_node_id": "reproduces",
    "target_node_id": "fix",
    "when": "passed"
   },
   {
    "id": "loop-reproduce",
    "source_node_id": "reproduces",
    "target_node_id": "reproduce",
    "when": "failed",
    "kind": "loop",
    "max_iterations": 2,
    "label": "Reproduce again"
   },
   {
    "id": "e-fix",
    "source_node_id": "fix",
    "target_node_id": "green"
   },
   {
    "id": "e-green",
    "source_node_id": "green",
    "target_node_id": "independent_review",
    "when": "passed"
   },
   {
    "id": "e-independent-review",
    "source_node_id": "independent_review",
    "target_node_id": "review"
   },
   {
    "id": "loop-fix",
    "source_node_id": "green",
    "target_node_id": "fix",
    "when": "failed",
    "kind": "loop",
    "max_iterations": 3,
    "label": "Fix \u2194 test"
   },
   {
    "id": "e-review",
    "source_node_id": "review",
    "target_node_id": "push",
    "when": "passed"
   },
   {
    "id": "loop-review",
    "source_node_id": "review",
    "target_node_id": "fix",
    "when": "failed",
    "kind": "loop",
    "max_iterations": 2,
    "label": "Review findings \u2194 fix"
   },
   {
    "id": "e-push",
    "source_node_id": "push",
    "target_node_id": "pr",
    "when": "succeeded"
   },
   {
    "id": "e-push-ko",
    "source_node_id": "push",
    "target_node_id": "action_failed",
    "when": "failed"
   },
   {
    "id": "e-pr",
    "source_node_id": "pr",
    "target_node_id": "in_review",
    "when": "succeeded"
   },
   {
    "id": "e-pr-ko",
    "source_node_id": "pr",
    "target_node_id": "action_failed",
    "when": "failed"
   },
   {
    "id": "e-in-review",
    "source_node_id": "in_review",
    "target_node_id": "ci",
    "when": "succeeded"
   },
   {
    "id": "e-in-review-ko",
    "source_node_id": "in_review",
    "target_node_id": "ci",
    "when": "failed"
   },
   {
    "id": "e-merged",
    "source_node_id": "merged",
    "target_node_id": "done",
    "when": "pr.merged"
   },
   {
    "id": "e-declined",
    "source_node_id": "merged",
    "target_node_id": "retry",
    "when": "pr.declined"
   },
   {
    "id": "loop-retry",
    "source_node_id": "retry",
    "target_node_id": "fix",
    "when": "confirmed",
    "kind": "loop",
    "max_iterations": 1,
    "label": "Retry after a declined PR"
   },
   {
    "id": "loop-reclarify",
    "source_node_id": "retry",
    "target_node_id": "reproduce",
    "when": "changed",
    "kind": "loop",
    "max_iterations": 1,
    "label": "Clarify again"
   },
   {
    "id": "e-retry-stop",
    "source_node_id": "retry",
    "target_node_id": "blocked",
    "when": "stopped"
   },
   {
    "id": "e-action-failed",
    "source_node_id": "action_failed",
    "target_node_id": "blocked"
   },
   {
    "id": "e-ci",
    "source_node_id": "ci",
    "target_node_id": "merged",
    "when": "ci.succeeded"
   },
   {
    "id": "loop-ci",
    "source_node_id": "ci",
    "target_node_id": "fix",
    "when": "ci.failed",
    "kind": "loop",
    "max_iterations": 2,
    "label": "CI red \u2194 fix"
   }
  ]
 }
}