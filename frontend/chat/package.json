{
  "name": "@octryx/chat-ui",
  "private": true,
  "version": "0.0.2-alpha",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && node tests/unit/commentStyleScan.mjs",
    "test": "node --import ./tests/unit/register-ts.mjs --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.12.0",
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.75",
    "@iconify/react": "^6.0.2",
    "@mintplex-labs/piper-tts-web": "^1.0.4",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.10.2",
    "katex": "^0.16.22",
    "monaco-editor": "^0.53.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^16.1.0",
    "react-virtuoso": "^4.18.10",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "simple-icons": "^16.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.59.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^8.0.11"
  }
}
